$TTL    604800
@       IN      SOA     ns1.example.local. admin.example.local. (
                              3         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
@       IN      NS      ns1.example.local.
@       IN      A       10.0.0.10
ns1     IN      A       10.0.0.10
www     IN      A       10.0.0.10
mail    IN      A       10.0.0.20
ftp     IN      A       10.0.0.30
